# === Configurações do Bot Telegram ===
TELEGRAM_TOKEN="SEU_TOKEN_AQUI"

# === Configurações do Grupo Principal ===
# ID do grupo onde ficam os tópicos (onde usuários interagem)
# Como obter: Use @userinfobot dentro do grupo
# Formato: -100XXXXXXXXXXXX (número negativo)
TELEGRAM_GROUP_ID="-100XXXXXXXXXXXX"

# === Configurações de Tópicos ===
# ID do tópico de regras (opcional)
# Como obter: Veja docs/TOPICS_DISCOVERY_GUIDE.md
RULES_TOPIC_ID="XX"
# ID do tópico de boas-vindas (opcional)
WELCOME_TOPIC_ID="XX"
# ID do tópico de suporte gamer (obrigatório para /suporte funcionar)
SUPPORT_TOPIC_ID="XXX"

# === Configurações de Notificações ===
# ID do CANAL técnico para notificações internas (diferente do grupo principal)
# Este é um canal separado onde a equipe técnica recebe alertas de suporte
# IMPORTANTE: Configure com o ID do seu canal técnico privado
# Como obter: Use @userinfobot dentro do canal
TECH_NOTIFICATION_CHANNEL_ID="-100XXXXXXXXXXXX"

# === Configurações de Link de Convite ===
# Tempo de expiração do link em segundos (padrão: 3600 = 1 hora)
INVITE_LINK_EXPIRE_TIME=3600
# Limite de membros que podem usar o link (padrão: 1)
INVITE_LINK_MEMBER_LIMIT=1

# === Configurações da API HubSoft ===
# Habilita ou desabilita a integração HubSoft (true/false)
HUBSOFT_ENABLED="true"
HUBSOFT_HOST="https://api.sua-instancia.hubsoft.com.br/"
HUBSOFT_CLIENT_ID="SEU_CLIENT_ID_AQUI"
HUBSOFT_CLIENT_SECRET="SEU_CLIENT_SECRET_AQUI"
HUBSOFT_USER="seu_usuario@email.com"
HUBSOFT_PASSWORD="SUA_SENHA_AQUI"

# === Endpoints da API HubSoft ===
# Configure os endpoints específicos do seu ERP (opcional - usa padrões se não definir)
HUBSOFT_ENDPOINT_TOKEN="/oauth/token"
HUBSOFT_ENDPOINT_CLIENTE="/api/v1/integracao/cliente"
HUBSOFT_ENDPOINT_ATENDIMENTO="/api/v1/integracao/atendimento"
HUBSOFT_ENDPOINT_ATENDIMENTO_MENSAGEM="/api/v1/integracao/atendimento/adicionar_mensagem"
HUBSOFT_ENDPOINT_CLIENTE_ATENDIMENTO="/api/v1/integracao/cliente/atendimento"

# === Configurações Específicas de Gaming ===
# ID do tipo de atendimento criado para suporte gaming (consulte seu painel HubSoft)
HUBSOFT_TIPO_ATENDIMENTO_GAMING="101"
# ID do status para abrir atendimento (2 = Aguardando Análise)
HUBSOFT_STATUS_ATENDIMENTO_ABERTO="2"

# === Configurações do Banco de Dados ===
# Caminho para o arquivo do banco SQLite
# IMPORTANTE: Use caminho absoluto /app/data/database/sentinela.db quando rodar via Docker
# ou caminho relativo data/database/sentinela.db para execução local
DATABASE_FILE="/app/data/database/sentinela.db"

# === FUNCIONALIDADES IMPLEMENTADAS ===
# Este arquivo .env configura um sistema completo que inclui:
#
# 🎮 SISTEMA DE SUPORTE:
# - Verificação automática de clientes via HubSoft
# - Formulário inteligente de suporte via chat (4 etapas)
# - Validação de tópico (só funciona no tópico de suporte)
# - Sistema duplo de notificações (admin + suporte)
#
# 🔐 SISTEMA DE CONTROLE DE ACESSO:
# - Usuários comuns: /start, /status, /suporte
# - Administradores: detectados AUTOMATICAMENTE via getChatAdministrators
# - Menu especial para admins com comandos futuros (Issue #8)
#
# 🔄 SISTEMA DE SINCRONIZAÇÃO:
# - Integração completa com HubSoft ERP
# - Criação automática de tickets com protocolo oficial
# - Fallback local quando HubSoft está indisponível
# - Notificações automáticas para administradores
#
# 📊 COMANDOS ADMINISTRATIVOS (EM DESENVOLVIMENTO - Issue #8):
# - /admin - Menu administrativo interativo
# - /stats - Estatísticas do bot (planejado)
# - Botões: Listar Tickets, Estatísticas, Sync HubSoft, Configurações
#
# 💡 IMPORTANTE PARA CONFIGURAÇÃO:
# 1. Configure TECH_NOTIFICATION_CHANNEL_ID para receber alertas técnicos
# 2. Configure SUPPORT_TOPIC_ID (obrigatório para /suporte funcionar)
# 3. Para produção, configure todas as credenciais HubSoft
# 4. Para testes, pode desabilitar HubSoft com HUBSOFT_ENABLED="false"
# 5. Admins são detectados AUTOMATICAMENTE - não precisa configurar IDs